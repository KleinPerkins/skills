{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "save-game-reconcile-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "repo_key", "clone_key", "workstream_key"],
  "properties": {
    "schema": { "type": "string", "enum": ["save-game-reconcile-observation/v1"] },
    "status": { "type": "string", "enum": [
      "MATCH", "UNADOPTED", "ADOPTION_DISABLED", "WORKSTREAM_UNAVAILABLE", "LOCK_BUSY",
      "INCOMPLETE_TRANSACTION", "INVALID_EVIDENCE", "IDENTITY_MISMATCH",
      "LIVE_STATE_CHANGED", "GIT_CONFLICT", "CHECKPOINT_AMBIGUOUS", "CHECKPOINT_STALE", "CHECKPOINT_UNADOPTED"
    ] },
    "repo_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clone_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workstream_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "generation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "generation": { "type": "integer" }
      }
    }
  }
}
